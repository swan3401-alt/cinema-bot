generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id          String    @id @default(cuid())
  title       String
  description String
  posterUrl   String
  date        DateTime
  time        String
  hall        String
  totalSeats  Int
  price       Int       // in UZS
  createdAt   DateTime  @default(now())
  seats       Seat[]
  bookings    Booking[]
}

model Seat {
  id        String   @id @default(cuid())
  movieId   String
  row       Int
  number    Int
  type      SeatType @default(STANDARD)
  isBooked  Boolean  @default(false)
  movie     Movie    @relation(fields: [movieId], references: [id])
  booking   Booking?
}

enum SeatType {
  WIDE
  STANDARD
}

model Booking {
  id            String        @id @default(cuid())
  movieId       String
  seatId        String        @unique
  telegramId    String
  token         String        @unique  // used in QR code
  status        BookingStatus @default(PENDING)
  paymentRef    String?       // GlobalPay transaction reference
  usedAt        DateTime?     // when QR was scanned at entrance
  createdAt     DateTime      @default(now())
  movie         Movie         @relation(fields: [movieId], references: [id])
  seat          Seat          @relation(fields: [seatId], references: [id])
}

enum BookingStatus {
  PENDING
  PAID
  USED
  CANCELLED
}

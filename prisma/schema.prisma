generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id          String    @id @default(cuid())
  title       String
  description String
  posterUrl   String
  date        DateTime
  time        String
  hall        String
  totalSeats  Int
  price       Int
  createdAt   DateTime  @default(now())
  seats       Seat[]
  bookings    Booking[]
}

model Seat {
  id        String    @id @default(cuid())
  movieId   String
  row       Int
  number    Int
  type      SeatType  @default(STANDARD)
  movie     Movie     @relation(fields: [movieId], references: [id])
  bookings  Booking[]
}

model Booking {
  id          String        @id @default(cuid())
  movieId     String
  seatId      String
  telegramId  String
  token       String        @unique
  status      BookingStatus @default(PENDING)
  paymentRef  String?
  paidAt      DateTime?
  usedAt      DateTime?
  createdAt   DateTime      @default(now())
  movie       Movie         @relation(fields: [movieId], references: [id])
  seat        Seat          @relation(fields: [seatId], references: [id])

  @@index([seatId, status])
  @@index([status, createdAt])
}

enum SeatType {
  WIDE
  STANDARD
}

enum BookingStatus {
  PENDING
  PAID
  USED
  EXPIRED
  CANCELLED
}
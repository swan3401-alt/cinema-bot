generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Hall {
  id        String    @id @default(cuid())
  name      String
  seats     Seat[]
  sessions  Session[]
  createdAt DateTime  @default(now())
}

model Seat {
  id       String    @id @default(cuid())
  hallId   String
  row      Int
  number   Int
  type     SeatType  @default(STANDARD)
  hall     Hall      @relation(fields: [hallId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([hallId, row, number])
}

model Movie {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  posterUrl   String
  createdAt   DateTime  @default(now())
  sessions    Session[]
}

model Session {
  id        String    @id @default(cuid())
  movieId   String
  hallId    String
  date      DateTime
  time      String
  price     Int
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  hall      Hall      @relation(fields: [hallId], references: [id])
  bookings  Booking[]
  createdAt DateTime  @default(now())

  @@index([date])
}

model Booking {
  id          String        @id @default(cuid())
  sessionId   String
  seatId      String
  telegramId  String
  locale      String        @default("uz")
  token       String        @unique
  status      BookingStatus @default(PENDING)
  paymentRef  String?
  paidAt      DateTime?
  usedAt      DateTime?
  reviewMsgId String?
  createdAt   DateTime      @default(now())
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seat        Seat          @relation(fields: [seatId], references: [id])

  @@index([seatId, status])
  @@index([status, createdAt])
  @@index([telegramId, status])
  @@index([sessionId, status])
}

model UserPref {
  telegramId String   @id
  locale     String   @default("uz")
  updatedAt  DateTime @updatedAt
}

enum SeatType { 
  WIDE 
  STANDARD 
}

enum BookingStatus {
  PENDING 
  AWAITING_PAYMENT 
  PAID 
  USED 
  EXPIRED 
  CANCELLED 
}